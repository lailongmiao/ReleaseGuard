# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="ReleaseGuard"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# Provider-neutral LLM Settings
# OPENAI_* remains a compatibility fallback. Prefer role-specific variables below.
LLM_PROVIDER=openai-compatible
LLM_API_KEY="your-provider-api-key"
LLM_ENDPOINT=https://api.openai.com/v1
DEFAULT_LLM_MODEL=your-chat-model

# DeepSeek or another OpenAI-compatible Chat provider
CHAT_LLM_PROVIDER=openai-compatible
CHAT_LLM_MODEL=your-chat-model
CHAT_LLM_ENDPOINT=https://api.deepseek.com/v1
CHAT_LLM_API_KEY="your-chat-api-key"
CHAT_LLM_SUPPORTS_CHAT=true
CHAT_LLM_SUPPORTS_STREAMING=true
CHAT_LLM_SUPPORTS_TOOLS=true
CHAT_LLM_SUPPORTS_STRUCTURED_OUTPUT=true
CHAT_LLM_SUPPORTS_REASONING=false
CHAT_LLM_SUPPORTS_USAGE=true

# Alibaba Cloud Model Studio (DashScope OpenAI-compatible endpoint)
MEMORY_LLM_PROVIDER=openai-compatible
MEMORY_LLM_MODEL=qwen-plus
MEMORY_LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
MEMORY_LLM_API_KEY="your-dashscope-api-key"
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY="your-dashscope-api-key"
EMBEDDING_DIMENSIONS=1536
JUDGE_LLM_PROVIDER=openai-compatible
JUDGE_LLM_MODEL=qwen-plus
JUDGE_LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
JUDGE_LLM_API_KEY="your-dashscope-api-key"
NAMING_LLM_PROVIDER=openai-compatible
NAMING_LLM_MODEL=qwen-plus
NAMING_LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
NAMING_LLM_API_KEY="your-dashscope-api-key"
NAMING_LLM_SUPPORTS_CHAT=true
NAMING_LLM_SUPPORTS_STRUCTURED_OUTPUT=true
NAMING_LLM_SUPPORTS_USAGE=true
EVALUATION_LLM=qwen-plus
EVALUATION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional JSON role map. If set, it must be a valid JSON object.
# LLM_ROLE_CONFIGS='{"chat":{"provider":"openai-compatible","model":"your-chat-model"}}'
DEFAULT_LLM_TEMPERATURE=0.2
SESSION_NAMING_ENABLED=true

# JWT Settings
JWT_SECRET_KEY="CHANGE_ME_TO_A_RANDOM_32_PLUS_CHAR_STRING"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Profiling Settings
PROFILING_DIR=/tmp/fastapi_profiles
PROFILING_THRESHOLD_SECONDS=2.0

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console
# Phase 8 local runtime (private values must be supplied at runtime)
# Required name: GRAFANA_ADMIN_PASSWORD (strong random private value)
# Optional names: LOCAL_API_PORT, LOCAL_DB_PORT, LOCAL_VALKEY_PORT,
# LOCAL_PROMETHEUS_PORT, LOCAL_GRAFANA_PORT, LOCAL_CADVISOR_PORT, RUNTIME_ENV_FILE
# Use a separate APP_ENV=test private file for test containers.
# Local synthetic ReleaseGuard API is opt-in and allowed only in development/test.
LOCAL_MVP_ENABLED=false
# Explicit provider-free mode: requires enabled=true, disables Chat/Memory/naming/tracing.
LOCAL_MVP_ONLY=false
